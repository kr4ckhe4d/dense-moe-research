+void llama_model::init_output_draft() const {
+    const char * path = getenv("LLAMA_MTP_DRAFT_VOCAB");
+    if (output_draft || !path || !output || output_s || !output->data || !output->buffer) {
+        return;
+    }
+    const int64_t n_embd  = output->ne[0];
+    const int64_t n_vocab = output->ne[1];
+
+    std::vector<int32_t> ids;
+    {
+        std::ifstream f(path);
+        std::vector<bool> seen(n_vocab, false);
+        int64_t id;
+        while (f >> id) {
+            if (id < 0 || id >= n_vocab || seen[id]) {
+                continue;
+            }
+            seen[id] = true;
+            ids.push_back((int32_t) id);
+        }
+        // control / special tokens (end of turn, tool markers) are always draftable
+        for (int32_t t = 0; t < (int32_t) n_vocab; ++t) {
+            if (!seen[t] && (vocab.is_control(t) || vocab.is_eog(t))) {
+                ids.push_back(t);
+            }
+        }
+    }
+    if (ids.empty()) {
+        LLAMA_LOG_WARN("%s: no usable token ids in '%s'\n", __func__, path);
+        return;
+    }
+
+    const size_t row_size = ggml_row_size(output->type, n_embd);
+    GGML_ASSERT(row_size * n_vocab == ggml_nbytes(output));
+
+    ggml_init_params ip = { ggml_tensor_overhead() * 2, nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * t = ggml_new_tensor_2d(ctx, output->type, n_embd, (int64_t) ids.size());
+    ggml_set_name(t, "output_draft.weight");
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_buffer_get_type(output->buffer));
+    if (!buf) {
+        LLAMA_LOG_WARN("%s: failed to allocate %zu bytes for the draft shortlist\n", __func__, row_size * ids.size());
+        ggml_free(ctx);
+        return;
+    }
+    ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    std::vector<uint8_t> src(ggml_nbytes(output));
+    ggml_backend_tensor_get(output, src.data(), 0, src.size());
+    std::vector<uint8_t> dst(row_size * ids.size());
+    for (size_t i = 0; i < ids.size(); ++i) {
+        memcpy(dst.data() + i * row_size, src.data() + (size_t) ids[i] * row_size, row_size);
+    }
+    ggml_backend_tensor_set(t, dst.data(), 0, dst.size());
+
+    output_draft_ids = std::move(ids);
+    output_draft     = t; // ctx and buf live as long as the process (prototype)
+    LLAMA_LOG_INFO("%s: MTP draft shortlist: %zu of %lld tokens, %.1f MiB (%s)\n", __func__,
+            output_draft_ids.size(), (long long) n_vocab, dst.size() / 1024.0 / 1024.0, ggml_type_name(output->type));
+}
