+// Whether the tile kernel reads q8_0 / q4_0 K/V directly (dequantizing while loading tiles)
+// instead of converting all of K/V to f16 first. Used for decode and small verify batches.
+static inline bool ggml_cuda_fattn_tile_native_quant(const ggml_tensor * dst) {
+#if defined(GGML_USE_HIP) && defined(FAST_FP16_AVAILABLE)
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    const bool type_ok = (K->type == GGML_TYPE_Q8_0 || K->type == GGML_TYPE_Q4_0) && V->type == K->type;
+    const bool size_ok = K->ne[0] == V->ne[0] && (K->ne[0] == 64 || K->ne[0] == 128 || K->ne[0] == 256);
+    return type_ok && size_ok && Q->ne[1] <= 8;
+#else
+    GGML_UNUSED(dst);
+    return false;
+#endif // defined(GGML_USE_HIP) && defined(FAST_FP16_AVAILABLE)
+}
+
