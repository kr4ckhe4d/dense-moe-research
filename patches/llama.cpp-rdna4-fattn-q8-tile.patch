 // Function that performs a single iteration in for the KQ matrix multiplication:
+#ifdef FAST_FP16_AVAILABLE
+// Load a tile of I rows x J values from q8_0 or q4_0 K/V data and dequantize it to half2,
+// so that small batches do not need an f16 copy of the whole K/V data.
+// KV_row0 points to the first row, e0 is the index of the first value within a row.
+template<int warp_size, int nwarps, int I, int J, int J_padding, bool oob_check, ggml_type type_KV>
+static __device__ __forceinline__ void flash_attn_tile_load_tile_quant(
+        const char * const __restrict__ KV_row0, half2 * const __restrict__ tile_KV, const int stride_KV, const int e0, const int i_sup) {
+    static_assert(type_KV == GGML_TYPE_Q8_0 || type_KV == GGML_TYPE_Q4_0, "bad type");
+    static_assert(QK8_0 == 32 && QK4_0 == 32, "bad block size");
+    constexpr int QK = 32;
+    static_assert(J % QK == 0, "bad J");
+    constexpr int nblocks  = J / QK; // quantization blocks per row within this tile
+    constexpr int nthreads = nwarps*warp_size;
+    const int tid = threadIdx.y*warp_size + threadIdx.x;
+
+#pragma unroll
+    for (int it0 = 0; it0 < I*nblocks; it0 += nthreads) {
+        const int it = it0 + tid;
+
+        if (it0 + nthreads <= I*nblocks || it < I*nblocks) {
+            const int i = it / nblocks;
+            const int b = it % nblocks;
+
+            half2 tmp[QK/2];
+            if (!oob_check || i < i_sup) {
+                const char * row = KV_row0 + int64_t(i)*stride_KV;
+                if constexpr (type_KV == GGML_TYPE_Q8_0) {
+                    constexpr int ne = QK/2; // values per call, limited by the max. copy size
+                    dequantize_V_q8_0<half, ne>(row, tmp,        e0 + b*QK);
+                    dequantize_V_q8_0<half, ne>(row, tmp + ne/2, e0 + b*QK + ne);
+                } else {
+                    // Low nibbles hold the first half of the block, high nibbles the second half.
+                    const block_q4_0 * x = (const block_q4_0 *) row + (e0/QK + b);
+                    uint8_t qs[QK/2];
+                    ggml_cuda_memcpy_1<sizeof(qs), 2>(qs, x->qs);
+                    const half2 d = __half2half2(x->d);
+#pragma unroll
+                    for (int l = 0; l < QK/4; ++l) {
+                        tmp[       l] = d * make_half2((qs[2*l] & 0x0F) - 8, (qs[2*l + 1] & 0x0F) - 8);
+                        tmp[QK/4 + l] = d * make_half2((qs[2*l] >>   4) - 8, (qs[2*l + 1] >>   4) - 8);
+                    }
+                }
+            } else {
+#pragma unroll
+                for (int l = 0; l < QK/2; ++l) {
+                    tmp[l] = make_half2(0.0f, 0.0f);
+                }
+            }
+
+            half2 * dst = tile_KV + i*(J/2 + J_padding) + b*(QK/2);
+#pragma unroll
+            for (int l = 0; l < QK/2; ++l) {
+                dst[l] = tmp[l];
+            }
+        }
+    }
+}
+#endif // FAST_FP16_AVAILABLE
